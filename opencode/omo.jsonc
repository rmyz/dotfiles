// OMO configuration
{
  "[opencode]": {
    "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
    // Warp's own plugin (@warp-dot-dev/opencode-warp) emits OSC 777 native notifications.
    // omo only auto-disables its osascript notifier for @mohak34/opencode-notifier, so disable it by hand.
    "disabled_hooks": ["session-notification"],
    "agents": {
      "sisyphus": {
        "model": "anthropic/claude-opus-5",
        "variant": "max",
        "fallback_models": [
          {
            "model": "github-copilot/claude-opus-5",
            "variant": "max"
          },
          {
            "model": "openai/gpt-5.6-sol",
            "variant": "medium"
          },
          {
            "model": "github-copilot/gpt-5.6-sol",
            "variant": "medium"
          }
        ]
      },
      "hephaestus": {
        "model": "openai/gpt-5.6-sol",
        "variant": "medium",
        "fallback_models": [
          {
            "model": "github-copilot/gpt-5.6-sol",
            "variant": "medium"
          }
        ]
      },
      "oracle": {
