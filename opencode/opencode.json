{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true
    },
    "Semantic code search MCP": {
      "type": "local",
      "command": ["bash", "/Users/sromeu/semantic-code-search-mcp.sh"],
      "enabled": false
    },
    "Chrome DevTools MCP": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": false
    },
    "Playwright MCP": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false
    }
  },
  "lsp": true,
  "formatter": true,
  "instructions": ["~/.config/opencode/rules/*.md"],
  "plugin": [
    "opencode-with-claude@latest",
    "@dietrichgebert/ponytail@latest"
  ],
  "provider": {
    "anthropic": {
      "options": {
        "baseURL": "http://127.0.0.1:3456",
        "apiKey": "dummy"
      }
    }
  }
}
