{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/claude-opus-5.5",
  "permission": "allow",
  "agent": {
    "ship-plan": {
      "mode": "primary",
      "permission": {
        "*": "allow",
        "edit": {
          "*": "deny",
          "*/oc-generated/plans/*.md": "allow"
        }
      }
    },
    "plan": {
      "disable": true
    },
    "build": {
      "mode": "all",
      "model": "github-copilot/gpt-6-luna",
      "variant": "medium",
      "permission": "allow"
    }
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true
    },
    "Semantic code search MCP": {
      "type": "local",
      "command": ["bash", "/Users/sromeu/semantic-code-search-mcp.sh"],
      "enabled": false
    }
  },
  "lsp": true,
  "formatter": true,
  "instructions": ["~/.config/opencode/rules/*.md"],
  "plugin": ["@dietrichgebert/ponytail@latest"]
}
