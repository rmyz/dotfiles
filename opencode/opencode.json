{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true
    },
    "Semantic code search MCP": {
      "type": "local",
      "command": ["bash", "/Users/sromeu/semantic-code-search-mcp.sh"],
      "enabled": false
    },
    "Chrome DevTools MCP": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": false
    },
    "Playwright MCP": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false
    }
  },
  "lsp": true,
  "formatter": true,
  "plugin": [
    "oh-my-openagent@latest",
    "opencode-claude-auth@latest",
    "@warp-dot-dev/opencode-warp",
    "@dietrichgebert/ponytail@latest",
    "opencode-rules@latest"
  ]
}
