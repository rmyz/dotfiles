{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/claude-opus-5.5",
  "permission": "allow",
  "agent": {
    "ship-plan": {
      "mode": "primary",
      "permission": {
        "*": "allow",
        "edit": {
          "*": "deny",
          "*/ai-generated/plans/*.md": "allow"
        }
      }
    },
    "plan": {
      "disable": true
    },
    "build": {
      "description": "Use for code inspection, CodeGraph queries, commands, edits, and tests.",
      "mode": "all",
      "model": "github-copilot/claude-sonnet-5.5",
      "permission": "allow"
    }
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true
    }
  },
  "lsp": true,
  "formatter": true,
  "snapshot": false,
  "plugin": ["@dietrichgebert/ponytail@latest"]
}
